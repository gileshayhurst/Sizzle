# ── Required in all modes ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Cloud mode only ────────────────────────────────────────────────────────────
APP_MODE=cloud

# URL of the sizzle-generator service (set automatically by render.yaml;
# set manually if running docker-compose locally or on another platform)
GENERATOR_URL=

# ── Transcript encoder jobs (cloud mode) ───────────────────────────────────────
# The app launches a Render one-off job to turn plain Forven transcripts into
# rich ones. Without these, /encode-session returns 503 and uploads keep their
# plain transcripts (working reels, looser clip boundaries).
#
# ⚠️ RENDER_API_KEY grants workspace-wide Render control and this app has NO
# authentication — see the security note in render_jobs.py before enabling.
RENDER_API_KEY=
RENDER_ENCODER_SERVICE_ID=
# Instance size for the job. Unset means it inherits the encoder service's free
# plan: it will work, but slowly. Per-second billing makes a big instance roughly
# cost-neutral for CPU-bound work, so set this generously.
ENCODER_JOB_PLAN_ID=
ENCODER_JOB_WORKERS=8
ENCODER_MAX_CONCURRENT_JOBS=2https://sizzle-generator.onrender.com

# S3-compatible storage — use Cloudflare R2 (free tier) or AWS S3
# For R2: get account ID from the Cloudflare dashboard
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Leave S3_ENDPOINT_URL blank/unset for standard AWS S3
